# Copy these into Render (Dashboard > your service > Environment).
# Never commit real values.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SECRET key ("service_role" or "sb_secret_..."). Keep it on the server only.
SUPABASE_SERVICE_KEY=

# A long random password for the /admin page (16+ characters).
ADMIN_TOKEN=

# Your Vercel site address(es), comma separated. Use * while testing.
ALLOWED_ORIGINS=https://your-site.vercel.app

# Optional
STORAGE_BUCKET=photos
IP_SALT=change-me-to-any-random-text
